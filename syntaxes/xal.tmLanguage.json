{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "xaligo",
  "scopeName": "text.xml.xaligo",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#connection-shorthand"
    },
    {
      "include": "#tags"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.xml.xaligo",
          "begin": "<!--",
          "end": "-->"
        }
      ]
    },
    "connection-shorthand": {
      "patterns": [
        {
          "name": "meta.connection.shorthand.xaligo",
          "match": "^\\s*([A-Za-z0-9_.:-]+)\\s*(---|==>)\\s*([A-Za-z0-9_.:-]+)\\s*$",
          "captures": {
            "1": {
              "name": "variable.other.source.xaligo"
            },
            "2": {
              "name": "keyword.operator.connection.xaligo"
            },
            "3": {
              "name": "variable.other.destination.xaligo"
            }
          }
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "meta.tag.xml.xaligo",
          "begin": "(</?)([a-z][a-z0-9-]*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.xml.xaligo"
            },
            "2": {
              "patterns": [
                {
                  "include": "#tag-names"
                }
              ]
            }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.xml.xaligo"
            }
          },
          "patterns": [
            {
              "include": "#attributes"
            },
            {
              "name": "punctuation.separator.key-value.xml.xaligo",
              "match": "="
            }
          ]
        }
      ]
    },
    "tag-names": {
      "patterns": [
        {
          "name": "keyword.control.layout.xaligo",
          "match": "\\b(?:xaligo|metadata|entry|imports|import|styles|style|data|frames|frame|container|row|col)\\b"
        },
        {
          "name": "support.type.data.xaligo",
          "match": "\\b(?:table-data|table|header|cell|database-schema|database|entity|column|primary-key|foreign-key)\\b"
        },
        {
          "name": "entity.name.type.cloud.xaligo",
          "match": "\\b(?:aws-account|aws-cloud|aws-cloud-alt|region|availability-zone|vpc)\\b"
        },
        {
          "name": "support.class.network.xaligo",
          "match": "\\b(?:public-subnet|private-subnet|security-group|auto-scaling-group)\\b"
        },
        {
          "name": "support.type.group.xaligo",
          "match": "\\b(?:server-contents|corporate-data-center|ec2-instance-contents|spot-fleet|aws-iot-greengrass-deployment|aws-iot-greengrass|elastic-beanstalk-container|aws-step-functions-workflow|generic-group)\\b"
        },
        {
          "name": "support.function.item.xaligo",
          "match": "\\b(?:item|spacer|blank)\\b"
        },
        {
          "name": "support.type.shape.xaligo",
          "match": "\\b(?:rectangle|port|card|panel|text)\\b"
        },
        {
          "name": "entity.name.type.uml.xaligo",
          "match": "\\b(?:uml-model|uml|class-diagram|component-diagram|activity-diagram|state-machine-diagram|sequence-diagram|partition|class|interface|enumeration|component|artifact|initial|final|activity|action|decision|merge|fork|join|object-node|state|history|choice|participant|lifeline|compartment|attribute|operation|constraint|note|literal|slot|responsibility|provided-interface|required-interface|property|entry|do|exit|region)\\b"
        },
        {
          "name": "keyword.operator.uml.relation.xaligo",
          "match": "\\b(?:association|aggregation|composition|generalization|realization|dependency|assembly|delegation|control-flow|object-flow|transition|message|return-message|create-message|destroy-message|relation)\\b"
        },
        {
          "name": "keyword.operator.connection.tag.xaligo",
          "match": "\\b(?:connections|connection)\\b"
        },
        {
          "name": "support.function.connection-point.xaligo",
          "match": "\\b(?:src|dst|bends|points|path|bend|point|via|waypoint)\\b"
        },
        {
          "name": "entity.name.tag.other.xaligo",
          "match": "\\b[a-z][a-z0-9-]*\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute-with-value.xml.xaligo",
          "begin": "\\b([a-z][a-z0-9-]*)\\b\\s*(=)",
          "beginCaptures": {
            "1": {
              "patterns": [
                {
                  "include": "#attribute-names"
                }
              ]
            },
            "2": {
              "name": "punctuation.separator.key-value.xml.xaligo"
            }
          },
          "end": "(?=\\s|/?>)",
          "patterns": [
            {
              "include": "#strings"
            }
          ]
        },
        {
          "patterns": [
            {
              "include": "#attribute-names"
            }
          ],
          "match": "\\b[a-z][a-z0-9-]*\\b"
        }
      ]
    },
    "attribute-names": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.known.xaligo",
          "match": "\\b(?:version|width|height|class|layout|gap|row-gap|title|id|src|dst|span|row|col|visible|border|item-size|font-size|font-family|arrowhead-size|margin|margin-top|margin-right|margin-bottom|margin-left|content-width|content-height|align|overflow|icon-id|name|ref|target|kind|color|key-color|background-color|key-background-color|border-color|key-width|break-before|stroke-width|stroke-style|arrowhead|start-arrowhead|end-arrowhead|side|anchor|src-side|dst-side|src-anchor|dst-anchor|src-frame-side|dst-frame-side|src-frame-anchor|dst-frame-anchor|x|y|dx|dy|bends|points|via|scale|coordinate-scale|grid|data|format|dialect|columns|references|on-delete|on-update|type|primary-key|nullable|unique|default|key|value|position|direction|lanes|theme|component-width|component-height|interface-width|lane|owner|stereotype|abstract|static|label|guard|event|action|route|src-multiplicity|dst-multiplicity|order|mode|description|show-element-names|tone)\\b"
        },
        {
          "name": "entity.other.attribute-name.xml.xaligo",
          "match": "\\b[a-z][a-z0-9-]*\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xml.xaligo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#entities"
            },
            {
              "include": "#spacing-classes"
            },
            {
              "include": "#constants"
            }
          ]
        },
        {
          "name": "string.quoted.single.xml.xaligo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#entities"
            },
            {
              "include": "#spacing-classes"
            },
            {
              "include": "#constants"
            }
          ]
        }
      ]
    },
    "entities": {
      "patterns": [
        {
          "name": "constant.character.entity.xml.xaligo",
          "match": "&(?:[a-zA-Z][a-zA-Z0-9]+|#[0-9]+|#x[0-9a-fA-F]+);"
        }
      ]
    },
    "spacing-classes": {
      "patterns": [
        {
          "name": "constant.language.spacing.xaligo",
          "match": "\\b(?:pa|ma|px|py|mx|my|pt|pr|pb|pl|mt|mr|mb|ml)-[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.anchor.xaligo",
          "match": "\\b(?:top|right|bottom|left)-(?:[1-5]|start|near|middle|mid|center|centre|far|end)\\b"
        },
        {
          "name": "constant.language.boolean.xaligo",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.layout.xaligo",
          "match": "\\b(?:horizontal|vertical|staggered|error|visible|top|right|bottom|left|middle|center|spread|solid|dashed|dotted|none|connection|traffic|route|arrow|triangle|stealth|diamond|oval|s)\\b"
        },
        {
          "name": "constant.numeric.xaligo",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    }
  }
}
