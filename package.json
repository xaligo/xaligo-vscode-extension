{
  "name": "xaligo-vscode-extension",
  "displayName": "xaligo",
  "description": "VS Code language support, interactive preview, and structural diff for the xaligo .xal diagram DSL.",
  "version": "0.0.18",
  "publisher": "xaligo",
  "license": "MIT",
  "icon": "assets/xaligo-icon-vscode-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xaligo/xaligo-vscode-extension.git"
  },
  "homepage": "https://github.com/xaligo/xaligo-vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/xaligo/xaligo-vscode-extension/issues"
  },
  "qna": false,
  "xaligo": {
    "packageName": "@xaligo/xaligo",
    "packageRoot": "node_modules/@xaligo/xaligo",
    "nativeBinaryDir": "bin/native",
    "nativeBinaryPlatformNames": {
      "win32": "windows"
    },
    "nativeBinaryArchNames": {
      "x64": "amd64"
    },
    "vsixNativeBinaryTargets": [
      {
        "platform": "darwin",
        "arch": "x64"
      },
      {
        "platform": "darwin",
        "arch": "arm64"
      },
      {
        "platform": "linux",
        "arch": "x64"
      },
      {
        "platform": "linux",
        "arch": "arm64"
      },
      {
        "platform": "win32",
        "arch": "x64"
      },
      {
        "platform": "win32",
        "arch": "arm64"
      }
    ]
  },
  "galleryBanner": {
    "color": "#0b2f73",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "xaligo",
    "xal",
    "diagram",
    "syntax",
    "preview",
    "structural-diff"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:xal",
    "onCommand:xaligo.openPreview",
    "onCommand:xaligo.openDiffPreview",
    "onCommand:xaligo.preview.zoomIn",
    "onCommand:xaligo.preview.zoomOut",
    "onCommand:xaligo.preview.resetZoom",
    "onCommand:xaligo.preview.resetView",
    "onCommand:xaligo.preview.close",
    "onCommand:xaligo.exportSvg",
    "onCommand:xaligo.exportPptx",
    "onCommand:xaligo.exportExcalidraw",
    "onCommand:xaligo.exportPdf",
    "onCommand:xaligo.exportExcel",
    "onCommand:xaligo.exportXyflow",
    "onCommand:xaligo.exportIsoflow",
    "onCommand:xaligo.validate",
    "onCommand:xaligo.showVersion",
    "onCommand:xaligo.runCliCommand",
    "onCommand:xaligo.showUpdates",
    "onCommand:xaligo.updateRuntime",
    "onCommand:xaligo.updateExtension",
    "onCommand:xaligo.showOutputChannel"
  ],
  "main": "./dist/extension/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xal",
        "aliases": [
          "xaligo",
          "Xaligo",
          "xal"
        ],
        "extensions": [
          ".xal"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/xaligo-file-icon.png",
          "dark": "./assets/xaligo-file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "xal",
        "scopeName": "text.xml.xaligo",
        "path": "./syntaxes/xal.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "xaligo.openPreview",
        "title": "Open Preview",
        "category": "xaligo",
        "icon": {
          "light": "./assets/xaligo-file-icon.svg",
          "dark": "./assets/xaligo-file-icon.svg"
        }
      },
      {
        "command": "xaligo.openDiffPreview",
        "title": "Open Structural Diff",
        "category": "xaligo",
        "icon": "$(diff)"
      },
      {
        "command": "xaligo.preview.zoomIn",
        "title": "Zoom In",
        "category": "xaligo",
        "icon": "$(zoom-in)"
      },
      {
        "command": "xaligo.preview.zoomOut",
        "title": "Zoom Out",
        "category": "xaligo",
        "icon": "$(zoom-out)"
      },
      {
        "command": "xaligo.preview.resetZoom",
        "title": "Reset Zoom",
        "category": "xaligo",
        "icon": "$(screen-normal)"
      },
      {
        "command": "xaligo.preview.resetView",
        "title": "Reset View",
        "category": "xaligo",
        "icon": "$(home)"
      },
      {
        "command": "xaligo.preview.close",
        "title": "Close Preview",
        "category": "xaligo",
        "icon": "$(close)"
      },
      {
        "command": "xaligo.exportSvg",
        "title": "Export as SVG",
        "category": "xaligo",
        "icon": "$(file-code)"
      },
      {
        "command": "xaligo.exportPptx",
        "title": "Export as PPTX",
        "category": "xaligo",
        "icon": "$(file-media)"
      },
      {
        "command": "xaligo.exportExcalidraw",
        "title": "Export as Excalidraw",
        "category": "xaligo",
        "icon": "$(json)"
      },
      {
        "command": "xaligo.exportPdf",
        "title": "Export as PDF",
        "category": "xaligo",
        "icon": "$(file-pdf)"
      },
      {
        "command": "xaligo.exportExcel",
        "title": "Export as Excel",
        "category": "xaligo",
        "icon": "$(table)"
      },
      {
        "command": "xaligo.exportXyflow",
        "title": "Export as XYFlow",
        "category": "xaligo",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "xaligo.exportIsoflow",
        "title": "Export as Isoflow",
        "category": "xaligo",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "xaligo.validate",
        "title": "Validate Diagram",
        "category": "xaligo",
        "icon": "$(check)"
      },
      {
        "command": "xaligo.showVersion",
        "title": "Show Runtime Version",
        "category": "xaligo",
        "icon": "$(versions)"
      },
      {
        "command": "xaligo.runCliCommand",
        "title": "Run CLI Feature…",
        "category": "xaligo",
        "icon": "$(terminal)"
      },
      {
        "command": "xaligo.showUpdates",
        "title": "Manage Updates",
        "category": "xaligo",
        "icon": "$(cloud-download)"
      },
      {
        "command": "xaligo.updateRuntime",
        "title": "Update xaligo Runtime",
        "category": "xaligo",
        "icon": "$(cloud-download)"
      },
      {
        "command": "xaligo.updateExtension",
        "title": "Update xaligo Extension",
        "category": "xaligo",
        "icon": "$(extensions)"
      },
      {
        "command": "xaligo.showOutputChannel",
        "title": "Show Output Channel",
        "category": "xaligo",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xaligo.openPreview",
          "when": "resourceLangId == xal || resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        },
        {
          "command": "xaligo.openDiffPreview",
          "when": "resourceLangId == xal",
          "group": "navigation@2"
        },
        {
          "command": "xaligo.exportSvg",
          "when": "resourceLangId == xal",
          "group": "navigation@3"
        },
        {
          "command": "xaligo.exportPptx",
          "when": "resourceLangId == xal",
          "group": "navigation@4"
        },
        {
          "command": "xaligo.exportExcalidraw",
          "when": "resourceLangId == xal",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "command": "xaligo.openPreview",
          "when": "resourceLangId == xal",
          "group": "navigation@1"
        },
        {
          "command": "xaligo.openDiffPreview",
          "when": "resourceLangId == xal",
          "group": "navigation@2"
        },
        {
          "command": "xaligo.exportSvg",
          "when": "resourceLangId == xal",
          "group": "navigation@3"
        },
        {
          "command": "xaligo.exportPptx",
          "when": "resourceLangId == xal",
          "group": "navigation@4"
        },
        {
          "command": "xaligo.exportExcalidraw",
          "when": "resourceLangId == xal",
          "group": "navigation@5"
        }
      ],
      "webview/title": [
        {
          "command": "xaligo.preview.zoomOut",
          "when": "webviewId == 'xaligoPreview'",
          "group": "navigation@1"
        },
        {
          "command": "xaligo.preview.resetZoom",
          "when": "webviewId == 'xaligoPreview'",
          "group": "navigation@2"
        },
        {
          "command": "xaligo.preview.zoomIn",
          "when": "webviewId == 'xaligoPreview'",
          "group": "navigation@3"
        },
        {
          "command": "xaligo.preview.resetView",
          "when": "webviewId == 'xaligoPreview'",
          "group": "navigation@4"
        },
        {
          "command": "xaligo.showUpdates",
          "when": "webviewId == 'xaligoPreview'",
          "group": "navigation@5"
        },
        {
          "command": "xaligo.preview.close",
          "when": "webviewId == 'xaligoPreview'",
          "group": "navigation@6"
        }
      ]
    },
    "configuration": {
      "title": "xaligo",
      "properties": {
        "xaligo.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to a xaligo native CLI. Leave empty to use the newest healthy managed or bundled runtime. Structural diff requires xaligo 0.1.21 or newer."
        },
        "xaligo.commandTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 3600,
          "scope": "machine-overridable",
          "description": "Maximum time in seconds for renderer, validation, Markdown, and diff commands. Increase this when Windows security scanning or large documents need more time."
        },
        "xaligo.servePort": {
          "type": "integer",
          "default": 8080,
          "minimum": 1,
          "maximum": 65535,
          "scope": "machine-overridable",
          "description": "HTTP port used by xaligo: Run CLI Feature… > Serve live preview."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.cjs && vite build && vite build --config vite.webview.config.ts",
    "watch": "vite build --watch",
    "watch:webview": "vite build --config vite.webview.config.ts --watch",
    "test": "vitest run",
    "check:renderer": "node scripts/check-native-renderer.cjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/prepare-vsix-native-binaries.cjs && node scripts/check-package-contents.cjs && vsce package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@xaligo/xaligo": "0.1.27",
    "element-plus": "^2.14.3",
    "tar": "^7.5.22",
    "vue": "^3.5.40",
    "vue-markdown-render": "^2.3.1"
  }
}
